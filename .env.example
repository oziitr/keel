KEEL_BIND=127.0.0.1
KEEL_PORT=4310
# Set to 1 behind HTTPS (reverse proxy).
# KEEL_SECURE=1
# Optional lock to one public URL. If unset, Origin is taken from the request Host.
# KEEL_PUBLIC_ORIGIN=https://keel.example.com
# KEEL_DATA=/var/lib/keel
# KEEL_JWT_TTL=14400
# Comma-separated directories to scan for projects.
# KEEL_SCAN_ROOTS=/root,/home,/var/www,/opt,/srv
# KEEL_SCAN_VHOSTS=0
